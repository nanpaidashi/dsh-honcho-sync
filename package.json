{
  "name": "@nanpaidashi/dsh-honcho-sync",
  "version": "0.7.0",
  "description": "DSH plugin: auto-sync conversation turns to Honcho memory service with full Honcho v3 API tools",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cp src/index.mjs dist/index.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "honcho",
    "memory",
    "cordis",
    "plugin",
    "long-term-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanpaidashi/dsh-honcho-sync"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "files": [
    "dist/",
    "cordis.patch.yml"
  ]
}
